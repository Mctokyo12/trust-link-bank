{
  "info": {
    "_postman_id": "trustlinkbank-api-collection-2026",
    "name": "Trust Link Bank API (Laravel 12)",
    "description": "Complete Postman collection for testing Trust Link Bank African Digital Banking REST API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Auth - Register",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Accept", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Amina Sow\",\n  \"email\": \"amina.new@novapay.africa\",\n  \"phone\": \"+237670998877\",\n  \"password\": \"SecurePass2026!\",\n  \"password_confirmation\": \"SecurePass2026!\",\n  \"country_code\": \"CM\",\n  \"language\": \"fr\"\n}"
        },
        "url": { "raw": "{{base_url}}/api/auth/register", "host": ["{{base_url}}"], "path": ["api", "auth", "register"] }
      }
    },
    {
      "name": "Auth - Login",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Accept", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"identifier\": \"amina@novapay.africa\",\n  \"password\": \"password123\"\n}"
        },
        "url": { "raw": "{{base_url}}/api/auth/login", "host": ["{{base_url}}"], "path": ["api", "auth", "login"] }
      }
    },
    {
      "name": "Wallets - List",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Accept", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "url": { "raw": "{{base_url}}/api/wallets", "host": ["{{base_url}}"], "path": ["api", "wallets"] }
      }
    },
    {
      "name": "Transfers - Create Transfer (Idempotent)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Accept", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token}}" },
          { "key": "Idempotency-Key", "value": "idem-uuid-{{$guid}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"source_wallet_id\": 1,\n  \"channel\": \"novapay\",\n  \"recipient_identifier\": \"@samuel99\",\n  \"recipient_name\": \"Samuel Eto'o\",\n  \"amount\": 50000,\n  \"reason\": \"Remboursement courses\"\n}"
        },
        "url": { "raw": "{{base_url}}/api/transfers", "host": ["{{base_url}}"], "path": ["api", "transfers"] }
      }
    },
    {
      "name": "Exchange - Request Quote",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Accept", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"from_currency\": \"USD\",\n  \"to_currency\": \"XAF\",\n  \"from_amount\": 100\n}"
        },
        "url": { "raw": "{{base_url}}/api/exchange/quote", "host": ["{{base_url}}"], "path": ["api", "exchange", "quote"] }
      }
    },
    {
      "name": "Transactions - Ledger List",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Accept", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "url": { "raw": "{{base_url}}/api/transactions?type=transfer&currency=XAF", "host": ["{{base_url}}"], "path": ["api", "transactions"], "query": [{ "key": "type", "value": "transfer" }, { "key": "currency", "value": "XAF" }] }
      }
    }
  ],
  "variable": [
    { "key": "base_url", "value": "http://localhost:8000" },
    { "key": "token", "value": "" }
  ]
}
